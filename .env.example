# Auvren's voice. Piper is the default: offline, free, no key. Install it and a
# voice with:  powershell -ExecutionPolicy Bypass -File scripts\get_piper.ps1
# and Auvren finds both on its own. Set these only to point somewhere else:
# PIPER_PATH=C:\tools\piper\piper.exe
# PIPER_MODEL=C:\tools\piper\voices\en_GB-alan-medium.onnx
# PIPER_LENGTH_SCALE=1.0   # >1 slower, <1 faster
# PIPER_SPEAKER=0          # multi-speaker voices only
# PIPER_MAX_PARALLEL=2     # voice models loaded at once

# Optional: Fish Audio instead (online, paid). Set both lines to use it.
# TTS_ENGINE=fish
# FISH_API_KEY=your-fish-audio-api-key-here

# Auvren's brain. By default a local model under Ollama (offline, free):
# install Ollama from ollama.com, then:  ollama pull qwen3:4b
# Coding work is still handed to Claude Code (spawn_run), so install and log in
# to Claude Code too if you want that.
# JARVIS_BRAIN=local         # or "claude": a Claude Code process on your
#                            # subscription answers instead (needs no Ollama)
# OLLAMA_MODEL=qwen3:4b      # any model `ollama list` shows; pick one that
#                            # supports tool calling (qwen3, llama3.2, ...)
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_NUM_CTX=8192        # context window; more costs RAM
# OLLAMA_KEEP_ALIVE=30m      # how long Ollama keeps the model loaded
# HONORIFIC=sir

# Speech recognition ON THIS MACHINE (faster-whisper) instead of Chrome's
# online recogniser:  pip install -r requirements-stt.txt && python stt.py --setup
# Used automatically once installed. While Auvren speaks it stops listening
# (a raw mic has no echo cancellation); say "Hey Auvren" or press Esc to cut
# him off.
# STT_ENGINE=auto             # auto | local | browser
# STT_MODEL=base.en           # tiny.en is faster, small.en more accurate
# STT_LISTEN_WHILE_SPEAKING=0 # 1 with headphones: talk over him freely
# STT_VAD_MIN_RMS=400         # raise it if a noisy room keeps "talking"
# MIC_DEVICE=                 # microphone number or name (see --setup)

# The wake word: "Hey Auvren" (said OV-ren). On by default: Auvren is asleep
# until he hears it, stays awake while he answers, and listens a few seconds
# after so "yes" needs no second wake word. Until a "hey auvren" model is
# trained it is heard by speech recognition; WAKE_WORD=hey_jarvis uses the
# pretrained openWakeWord model instead (requirements-wakeword.txt).
# WAKE_WORD=hey_auvren        # "off" to answer everything, hey_jarvis, or a .onnx path
# WAKE_THRESHOLD=0.5          # audio engine only: higher = fewer false wakes
# WAKE_WINDOW_SEC=8           # how long one wake word listens for a request
# WAKE_FOLLOW_UP_SEC=8        # how long he listens after he has spoken

# In the background (scripts\install_autostart.ps1 runs `pythonw server.py
# --background` at sign-in): when the wake word is heard and no Auvren window
# is open, he opens one (Chrome or Edge, an app window on its own profile),
# plays the intro and asks "Yes, sir?" -- or answers what you said in the
# same breath. Needs on-device speech recognition (above).
# AUVREN_SUMMON=1             # 0: never open a window on the wake word
# AUVREN_APP_URL=             # where that window points (default: this server)
# AUVREN_TRAY=1               # the tray icon (pip install -r requirements-tray.txt)

# With JARVIS_BRAIN=claude, or for coding runs: Claude Code (2.1.224+) on YOUR
# Claude subscription. Log in with `claude` — no Anthropic API key is needed,
# and any ANTHROPIC_* variable set here is deliberately hidden from it.

# Optional: which model the Claude brain runs (default sonnet)
# JARVIS_BRAIN_MODEL=sonnet

# Optional: Fish Audio voice model (only with TTS_ENGINE=fish)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (Auvren will address you by name)
# USER_NAME=Tony

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because Auvren is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running Auvren interactively in a terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, Auvren uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # or "celsius"
